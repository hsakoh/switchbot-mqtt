{
  "DeviceType": "LockUltraMax",
  "ApiDeviceTypeString": "Smart Lock Ultra Max",
  // WebhookDeviceTypeString: the official webhook example says "Smart Lock Ultra Max", but a real device (firmware V0.8) sends "Lock Ultra Max" (home-assistant/core#192305).
  // Webhooks are matched to devices by deviceMac. This value is only used to display deviceType (if it does not match, ApiDeviceTypeString is used).
  "WebhookDeviceTypeString": "Lock Ultra Max",
  "PhysicalOrVirtual": "PhysicalDevice",
  "IsSupportPolling": true,
  "IsSupportWebhook": true,
  "IsSupportCommand": true,
  "DisplayName": "Smart Lock Ultra Max",
  "Fields": [
    {
      "FieldName": "battery",
      "FieldSourceType": "both",
      "StatusKey": "battery",
      "WebhookKey": "battery",
      "FieldDataType": "Integer",
      "Description": "the current battery level, 0-100",
      "IsBinary": false,
      "SensorDeviceClass": "battery",
      "StateClass": "measurement",
      "UnitOfMeasurement": "%"
    },
    {
      "FieldName": "version",
      "FieldSourceType": "status",
      "StatusKey": "version",
      "FieldDataType": "String",
      "Description": "the current firmware version, e.g. V6.3",
      "IsBinary": false,
      "Icon": "mdi:information",
      "EntityCategory": "diagnostic"
    },
    {
      "FieldName": "lockState",
      "FieldSourceType": "both",
      "StatusKey": "lockState",
      "WebhookKey": "lockState",
      "FieldDataType": "String",
      "Description": "locked, unlocked, locking, unlocking, jammed, latchBoltLocked, halfLocked",
      "IsBinary": true,
      "BinarySensorDeviceClass": "lock",
      "OnValue": "unlocked",
      "OffValue": "locked"
    },
    // doorState: status only in the official docs, but a real device (firmware V0.8) also sends it in webhooks as "OPENED" / "CLOSED" (home-assistant/core#192305); webhook values are lowercased.
    // The docs list "open, close", but they said the same for Lock Ultra and real devices returned "opened" / "closed", so the values match the other locks.
    {
      "FieldName": "doorState",
      "FieldSourceType": "both",
      "StatusKey": "doorState",
      "WebhookKey": "doorState",
      "FieldDataType": "String",
      "Description": "determines if the door is closed or not",
      "IsBinary": true,
      "BinarySensorDeviceClass": "door",
      "OnValue": "opened",
      "OffValue": "closed"
    },
    {
      "FieldName": "calibrate",
      "FieldSourceType": "status",
      "StatusKey": "calibrate",
      "FieldDataType": "Boolean",
      "Description": "determines if Lock has been calibrated or not",
      "IsBinary": false,
      "Icon": "mdi:check-circle"
    },
    {
      "FieldName": "deviceId",
      "FieldSourceType": "both",
      "StatusKey": "deviceId",
      "WebhookKey": "deviceMac",
      "FieldDataType": "String",
      "Description": "the MAC address of the device. device ID ",
      "IsBinary": false,
      "Icon": "mdi:information",
      "EntityCategory": "diagnostic"
    },
    {
      "FieldName": "deviceType",
      "FieldSourceType": "both",
      "StatusKey": "deviceType",
      "WebhookKey": "deviceType",
      "FieldDataType": "String",
      "Description": "the type of the device",
      "IsBinary": false,
      "Icon": "mdi:information",
      "EntityCategory": "diagnostic"
    },
    {
      "FieldName": "hubDeviceId",
      "FieldSourceType": "status",
      "StatusKey": "hubDeviceId",
      "FieldDataType": "String",
      "Description": "device's parent Hub ID. 000000000000 when the device itself is a Hub or it is connected through Wi-Fi.",
      "IsBinary": false,
      "Icon": "mdi:information",
      "EntityCategory": "diagnostic"
    },
    {
      "FieldName": "timeOfSample",
      "FieldSourceType": "webhook",
      "WebhookKey": "timeOfSample",
      "FieldDataType": "Long",
      "Description": "the time stamp when the event is sent",
      "IsBinary": false,
      "SensorDeviceClass": "timestamp"
    }
  ],
  "Commands": [
    {
      "CommandType": "command",
      "Command": "lock",
      "PayloadType": "Default",
      "Description": "rotate to locked position",
      "Icon": "mdi:lock",
      "Payloads": []
    },
    {
      "CommandType": "command",
      "Command": "unlock",
      "PayloadType": "Default",
      "Description": "rotate to unlocked position",
      "Icon": "mdi:lock-open-variant",
      "Payloads": []
    },
    {
      "CommandType": "command",
      "Command": "deadbolt",
      "PayloadType": "Default",
      "Description": "disengage deadbolt or latch",
      "Icon": "mdi:lock-open-variant",
      "Payloads": []
    }
  ]
}
